{
  "name": "video-pro-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "vite --watch",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage=false",
    "test:e2e": "playwright test",
    "package": "node scripts/package-extension.js",
    "ci": "npm run format:check && npm run lint && npm run test && npm run build && npm run test:e2e && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "playwright": "^1.49.1",
    "prettier": "^3.3.1",
    "vite": "^5.4.10"
  }
}
